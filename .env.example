# ==============================================================================
# SONORA Environment Configuration Example
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or real credentials to Git.
# ==============================================================================

# Application
APP_URL=http://127.0.0.1:3000
AUTH_SECRET=replace-with-at-least-32-chars-random-local-secret

# Demo Authentication (strictly allowed ONLY when NODE_ENV=development and DEMO_AUTH_ENABLED=true)
# Default is false; MUST remain false or unset in production and staging
DEMO_AUTH_ENABLED=false

# Database (PostgreSQL)
# Local development default points to docker-compose postgres service
DATABASE_URL=postgresql://sonora_user:sonora_password@localhost:5432/sonora_dev?schema=public

# Redis (for background jobs and rate limiting)
REDIS_URL=redis://localhost:6379

# Encryption key for provider tokens at rest (32-byte base64 string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key-placeholder

# Spotify (Phase 3 - Developer Portal credentials)
SPOTIFY_CLIENT_ID=placeholder-spotify-client-id
SPOTIFY_CLIENT_SECRET=placeholder-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/v1/connections/spotify/callback

# Apple Music (Phase 3 - Developer account credentials)
APPLE_TEAM_ID=placeholder-apple-team-id
APPLE_MUSIC_KEY_ID=placeholder-apple-key-id
APPLE_MUSIC_PRIVATE_KEY_PATH=/secure/local/path/AuthKey_placeholder.p8

# Google / YouTube (Phase 5 - Google Cloud Console credentials)
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/connections/youtube/callback
